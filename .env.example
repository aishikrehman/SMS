# Dhee SMS — configuration. Copy to .env and adjust. Real environment variables win over this file.
# Check it with:  npm run check
# Lines starting with # are comments; the value shown is the default.

# ---------------------------------------------------------------- server
# Port and address the Node server listens on. Behind nginx/Caddy use HOST=127.0.0.1.
PORT=3000
# HOST=0.0.0.0
# production (default) or development. `npm run dev` switches to development
# (one-time codes are then printed on the console when no SMS/e-mail provider is set).
# NODE_ENV=production

# Behind a reverse proxy that terminates HTTPS (nginx, Caddy, IIS …):
#   true  = exactly one proxy in front (most setups); a number = that many proxy hops;
#   or a list of trusted proxy addresses, e.g. "loopback, 10.0.0.0/8".
# Needed for the real client IP (audit log, rate limits) and for Secure cookies. Never set it
# when clients reach Node directly — they could then fake their IP address.
# TRUST_PROXY=false

# ---------------------------------------------------------------- sessions & cookies
# A sign-in ends after SESSION_TTL_HOURS at the latest, or after SESSION_IDLE_MINUTES without use.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Secure flag of the session cookie: auto (= when the request came over HTTPS), true or false.
# COOKIE_SECURE=auto
# SameSite attribute of the session cookie: Lax (default) or Strict.
# COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------- request size limits
# Largest save request (all changed keys together).
JSON_LIMIT=50mb
# Largest single top-level collection a browser may save, in MB.
# KEY_MAX_MB=25
# Largest save request from a student or guardian, in MB.
# USER_JSON_MAX_MB=8

# ---------------------------------------------------------------- sign-in protection
# Failed sign-ins per account before it is locked (1 min, then doubling up to LOCK_MINUTES).
# LOGIN_MAX_PER_ACCOUNT=5
# Failed sign-ins per IP address within 15 minutes before that address is locked
# (LOCK_MINUTES, doubling for repeat offenders, at most a day).
# LOGIN_MAX_PER_IP=30
# LOCK_MINUTES=15

# ---------------------------------------------------------------- database
# sqlite (default) | postgres | both
DB_DRIVER=sqlite
SQLITE_PATH=data/dhee.sqlite
# PostgreSQL (DB_DRIVER=postgres or both)
# DATABASE_URL=postgres://dhee:secret@localhost:5432/dhee
# PGSSL=false
# In "both" mode: which store serves reads (the other one receives copies of every write)
# DB_PRIMARY=sqlite

# ---------------------------------------------------------------- backups
# Folder for backups (keep it on another disk, and copy it off the server regularly).
# BACKUP_DIR=backups
# Daily automatic backup on/off, and the local hour after which it runs.
# BACKUP_AUTO=true
# BACKUP_HOUR=2
# Backups older than this many days are deleted (the newest three always stay).
# BACKUP_KEEP_DAYS=30

# ---------------------------------------------------------------- logs
# Daily JSON-line files: logs/app-YYYY-MM-DD.log and logs/access-YYYY-MM-DD.log
# LOG_DIR=logs
# LOG_KEEP_DAYS=30
# One access-log line per API request (no bodies, no query strings, no secrets).
# LOG_REQUESTS=true

# ---------------------------------------------------------------- one-time codes for password recovery
# SMS: POST JSON { to, message, sender } with "Authorization: Bearer <token>"
# SMS_API_URL=https://sms.example.com/send
# SMS_API_TOKEN=
# SMS_SENDER_ID=
# E-mail: POST JSON { from, to, subject, text } with "Authorization: Bearer <token>"
# EMAIL_API_URL=https://mail.example.com/send
# EMAIL_API_TOKEN=
# EMAIL_FROM=no-reply@example.edu.bd

# ---------------------------------------------------------------- developer information (vendor only)
# Shown under "ডেভেলপার তথ্য" in every dashboard; schools cannot change these in the app.
# DEVELOPER_PRODUCT=Dhee SMS
# DEVELOPER_COMPANY=DHEE
# DEVELOPER_WEBSITE=https://example.com
# DEVELOPER_EMAIL=support@example.com
# DEVELOPER_PHONE=
# DEVELOPER_ADDRESS=
# DEVELOPER_SUPPORT_HOURS=
# Small "Dhee SMS" credit in the public website's footer (switch off per plan).
# DEVELOPER_CREDIT=true

# ---------------------------------------------------------------- demo data from the UI
# Root User → পরীক্ষামূলক ডেটা: "load the demo data" and "wipe everything and start afresh"
# (both take a backup first and keep the Root User). SET THIS TO false ON A LIVE SCHOOL.
# ALLOW_DEMO_LOAD=true

# ---------------------------------------------------------------- IT office alerts
# New password-help requests ("forgot password → ask the IT office") are sent here through the
# SMS / e-mail provider above. The Root User can also set them in the app (Features & Settings → আইটি অফিস).
# IT_OFFICE_PHONE=
# IT_OFFICE_EMAIL=

# ---------------------------------------------------------------- online payment (server-side)
# Gateway and server address are chosen in the app (Features & Settings → পেমেন্ট গেটওয়ে).
# Secret API key of the payment server (Hyperswitch: the "api-key"; custom server: sent as Bearer token).
# PAY_API_KEY=
# Shared secret for the gateway's signed callback POST /api/pay/webhook
# (header x-webhook-signature-512 = HMAC-SHA512, or x-dhee-signature = HMAC-SHA256, of the raw body).
# Online checkout stays off until this is set; TrxID claims and counter payments always work.
# PAY_WEBHOOK_SECRET=
